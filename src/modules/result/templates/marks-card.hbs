<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f8fbff;
      color: #172033;
    }
    .page {
      width: 100%;
      min-height: 100vh;
      padding: 26px;
      background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
    }
    .sheet {
      width: 100%;
      border: 2px solid #dbeafe;
      border-radius: 26px;
      background: #fff;
      overflow: hidden;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }
    .header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 24px 14px;
      border-bottom: 1px solid #e2e8f0;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
      flex: 1;
    }
    .logo {
      width: 64px;
      height: 64px;
      border-radius: 18px;
      object-fit: cover;
      border: 2px solid #dbeafe;
    }
    .brand-text {
      min-width: 0;
    }
    .school-name {
      font-size: 24px;
      font-weight: 900;
      margin: 0;
      line-height: 1.1;
    }
    .school-address {
      margin-top: 4px;
      color: #64748b;
      font-size: 12px;
    }
    .badge {
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.08);
      color: #2563eb;
      padding: 8px 14px;
      font-weight: 900;
      font-size: 12px;
      letter-spacing: .4px;
    }
    .title-block {
      text-align: center;
      padding: 18px 24px 0;
    }
    .title {
      margin: 0;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: .3px;
    }
    .subtitle {
      margin-top: 6px;
      font-size: 12px;
      color: #64748b;
    }
    .grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 14px;
      padding: 18px 24px 0;
    }
    .student-card, .summary-card, .seal-card, .sign-card, .table-wrap, .meta-card {
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      background: #fafdff;
    }
    .student-card {
      display: flex;
      gap: 14px;
      padding: 14px;
      align-items: center;
    }
    .student-photo {
      width: 88px;
      height: 104px;
      border-radius: 18px;
      object-fit: cover;
      border: 1px solid #dbeafe;
      background: #eff6ff;
      flex-shrink: 0;
    }
    .student-copy {
      min-width: 0;
    }
    .label {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .3px;
    }
    .student-name {
      margin-top: 4px;
      font-size: 22px;
      font-weight: 900;
      line-height: 1.1;
    }
    .meta {
      margin-top: 5px;
      font-size: 12px;
      color: #64748b;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .summary-card, .meta-card {
      padding: 12px 14px;
    }
    .summary-value {
      margin-top: 4px;
      font-size: 18px;
      font-weight: 900;
    }
    .percentage-box {
      margin: 18px 24px 0;
      padding: 12px 14px;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
    }
    .percentage-label {
      color: #64748b;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
    }
    .percentage-value {
      color: #2563eb;
      font-size: 24px;
      font-weight: 900;
    }
    .table-wrap {
      margin: 18px 24px 0;
      overflow: hidden;
    }
    .table-head, .table-row {
      display: grid;
      grid-template-columns: 1.7fr .7fr .8fr .6fr;
      gap: 12px;
      padding: 12px 14px;
      align-items: center;
    }
    .table-head {
      background: #f8fbff;
      border-bottom: 1px solid #e2e8f0;
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
    }
    .table-row {
      font-size: 13px;
      border-top: 1px solid #edf2f7;
    }
    .table-row:nth-child(even) { background: #fbfdff; }
    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 18px 24px 0;
    }
    .footer-card {
      padding: 14px;
      border-radius: 18px;
      border: 1px solid #e2e8f0;
      background: #fafdff;
    }
    .footer-value {
      margin-top: 4px;
      font-size: 14px;
      font-weight: 800;
    }
    .sign-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 18px 24px 24px;
    }
    .sign-card, .seal-card {
      padding: 14px;
      min-height: 140px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .sign-image {
      width: 100%;
      height: 68px;
      object-fit: contain;
      margin-top: 8px;
    }
    .seal-image {
      width: 82px;
      height: 82px;
      object-fit: contain;
      margin-top: 8px;
      align-self: center;
    }
    .subject-name { font-weight: 800; }
    .footer-note {
      padding: 0 24px 18px;
      color: #64748b;
      font-size: 11px;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="sheet">
      <div class="header">
        <div class="brand">
          <img class="logo" src="{{schoolLogo}}" alt="School logo" />
          <div class="brand-text">
            <div class="school-name">{{schoolName}}</div>
            <div class="school-address">{{schoolAddress}}</div>
          </div>
        </div>
        <div class="badge">{{approvalLabel}}</div>
      </div>

      <div class="title-block">
        <h1 class="title">MID TERM MARKS SHEET</h1>
        <div class="subtitle">{{examName}} - {{examType}}</div>
      </div>

      <div class="grid">
        <div class="student-card">
          <img class="student-photo" src="{{studentPhoto}}" alt="Student photo" />
          <div class="student-copy">
            <div class="label">Student</div>
            <div class="student-name">{{studentName}}</div>
            <div class="meta">Father: {{fatherName}}</div>
            <div class="meta">Roll {{rollNumber}} - Section {{sectionName}}</div>
          </div>
        </div>

        <div class="summary-grid">
          <div class="summary-card">
            <div class="label">Class</div>
            <div class="summary-value">{{className}}</div>
          </div>
          <div class="summary-card">
            <div class="label">Section</div>
            <div class="summary-value">{{sectionName}}</div>
          </div>
          <div class="summary-card">
            <div class="label">Total</div>
            <div class="summary-value">{{summary.total}}</div>
          </div>
          <div class="summary-card">
            <div class="label">Obtained</div>
            <div class="summary-value">{{summary.obtained}}</div>
          </div>
        </div>
      </div>

      <div class="percentage-box">
        <div class="percentage-label">Overall Percentage</div>
        <div class="percentage-value">{{summary.percentage}}%</div>
      </div>

      <div class="table-wrap">
        <div class="table-head">
          <div>Subject</div>
          <div>Max</div>
          <div>Obtained</div>
          <div>Grade</div>
        </div>
        {{#each subjects}}
          <div class="table-row">
            <div class="subject-name">{{name}}</div>
            <div>{{max}}</div>
            <div>{{obtained}}</div>
            <div>{{grade}}</div>
          </div>
        {{/each}}
      </div>

      <div class="footer-grid">
        <div class="footer-card">
          <div class="label">Remarks</div>
          <div class="footer-value">{{summary.remarks}}</div>
        </div>
        <div class="footer-card">
          <div class="label">Status</div>
          <div class="footer-value">{{approvalLabel}}</div>
        </div>
      </div>

      <div class="sign-grid">
        <div class="sign-card">
          <div class="label">Signature</div>
          <img class="sign-image" src="{{signatureImage}}" alt="Signature" />
        </div>
        <div class="seal-card">
          <div class="label">Seal</div>
          <img class="seal-image" src="{{sealImage}}" alt="Seal" />
        </div>
      </div>
      <div class="footer-note">Approved marks sheet generated by the school admin.</div>
    </div>
  </div>
</body>
</html>
