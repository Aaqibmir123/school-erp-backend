NODE_ENV=production
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace-with-a-strong-access-token-secret
REFRESH_JWT_SECRET=replace-with-a-different-strong-refresh-token-secret
SUPER_ADMIN_PHONE=your_super_admin_phone
SUPER_ADMIN_PASSWORD=your_super_admin_password
CLIENT_URLS=https://smartschoolerp.co.in,https://www.smartschoolerp.co.in
WEB_APP_URL=https://smartschoolerp.co.in
PHONE_AUTH_PROVIDER=firebase

# Optional but recommended for media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional only if email sending is used
EMAIL_USER=
EMAIL_PASS=

# Optional only if Firebase phone auth/login is used in production
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
